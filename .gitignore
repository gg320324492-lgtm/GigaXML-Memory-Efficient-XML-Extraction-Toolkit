# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Python bytecode / build artifacts ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ---- Generated / benchmark data (never commit large XML) ----
data/
*.xml
*.xml.gz
*.parquet

# ---- Test & lint caches ----
.pytest_cache/
.ruff_cache/
coverage.xml
.coverage
htmlcov/

# ---- Editors / OS ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- Agent workspace metadata (not part of the project) ----
.workbuddy-ai/

# ---- Exception: small committed test fixtures ----
!tests/fixtures/**/*.xml
!tests/fixtures/**/*.xml.gz

# ---- Local working notes: development journals, kept out of the repository ----
# The whole directory, not a list of name patterns. It is not tracked at all (see the
# commit that removed it), so enumerating patterns only creates ways to miss: a new kind
# of internal file -- a preflight note, say -- matches none of them and shows up as
# untracked. Committing something from here on purpose needs `git add -f`, and that
# friction is the point.
docs/

# 本机临时工作区（pytest --basetemp / 探针产物）。只在本机，永不提交。
.scratch/
